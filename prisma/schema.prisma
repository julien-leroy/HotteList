// HotteList — modèle de données (cf. docs/architecture.md, §7)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String?
  /// e-mail ou pseudo ; vide pour un compte géré
  login        String?  @unique
  passwordHash String?
  avatarColor  String   @default("#1F4D36")
  /// adresse e-mail facultative, utilisée seulement une fois confirmée
  email           String?   @unique
  emailVerifiedAt DateTime?
  /// rappel par e-mail quelques jours avant l'événement
  emailReminders  Boolean   @default(true)
  /// e-mail quand quelqu'un me mentionne (@Prénom) dans un commentaire
  emailMentions   Boolean   @default(true)
  /// compte administré « en procuration » par un autre utilisateur
  managedById  String?
  managedBy    User?    @relation("Managed", fields: [managedById], references: [id], onDelete: Cascade)
  managed      User[]   @relation("Managed")
  createdAt    DateTime @default(now())

  sessions       Session[]
  memberships    Membership[]
  familiesMade   Family[]             @relation("FamilyCreator")
  giftsFor       Gift[]               @relation("GiftRecipient")
  giftsWritten   Gift[]               @relation("GiftAuthor")
  participations GiftParticipant[]
  comments       Comment[]
  resetTokens    PasswordResetToken[]
  notifications  Notification[]
  emailCodes     EmailCode[]
  santaGives     SecretSantaAssignment[] @relation("SantaGiver")
  santaReceives  SecretSantaAssignment[] @relation("SantaReceiver")
}

model Session {
  /// empreinte SHA-256 du jeton stocké dans le cookie
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Family {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdById String
  createdBy   User         @relation("FamilyCreator", fields: [createdById], references: [id])
  eventDate   DateTime
  /// titre de l'événement : « Noël » par défaut, ou « Anniversaire de Léa »…
  eventName   String       @default("Noël")
  /// date (AAAA-MM-JJ) de l'événement pour lequel le rappel J-7 est parti
  reminderSentFor String?
  createdAt   DateTime     @default(now())
  memberships Membership[]
  gifts       Gift[]
  secretSantas SecretSanta[]
}

model Membership {
  id       String   @id @default(cuid())
  userId   String
  familyId String
  /// ADMIN | MEMBRE
  role     String   @default("MEMBRE")
  joinedAt DateTime @default(now())
  /// visites de la page famille : le badge « Nouveau » compare à la visite précédente
  lastSeenAt DateTime?
  prevSeenAt DateTime?
  /// nom affiché dans cette famille (« Maman », « Papi Michou »…), sinon le prénom
  nickname   String?
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
}

model Gift {
  id               String    @id @default(cuid())
  familyId         String
  family           Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  recipientId      String
  recipient        User      @relation("GiftRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User      @relation("GiftAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  /// SOUHAIT | IDEE
  kind             String
  title            String
  description      String?
  url              String?
  price            String?
  /// adresse externe de l'image (jamais stockée sur le serveur)
  imageUrl         String?
  siteOrigin       String?
  favorite         Boolean   @default(false)
  position         Int       @default(0)
  /// AUCUN | SEUL | A_PLUSIEURS
  takeMode         String    @default("AUCUN")
  /// date de la dernière modification du contenu (titre, prix, lien…)
  contentUpdatedAt DateTime  @default(now())
  archivedAt       DateTime?
  archiveYear      Int?
  /// événement pour lequel le cadeau a été offert (« Noël », « Anniversaire de Léa »…)
  archiveEvent     String?
  /// suppression annulable quelques secondes (« Annuler »)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  participants GiftParticipant[]
  comments     Comment[]

  @@index([familyId, archivedAt])
  @@index([recipientId])
}

model GiftParticipant {
  giftId    String
  userId    String
  createdAt DateTime @default(now())
  /// statut d'achat, visible seulement par ce participant : A_ACHETER | ACHETE | EMBALLE
  status    String   @default("A_ACHETER")
  gift      Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([giftId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  giftId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())
  gift      Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([giftId])
}

model PasswordResetToken {
  /// empreinte SHA-256 du jeton
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Codes à 6 chiffres envoyés par e-mail (seule l'empreinte est stockée)
model EmailCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// adresse à laquelle le code a été envoyé
  email     String
  /// VERIFY (confirmer l'adresse) | LOGIN (connexion par code) | RESET (mot de passe oublié)
  purpose   String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
  @@index([userId, purpose])
}

/// Tirage au sort « qui offre à qui » dans une famille
model SecretSanta {
  id          String                  @id @default(cuid())
  familyId    String
  family      Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdById String
  budget      String?
  createdAt   DateTime                @default(now())
  assignments SecretSantaAssignment[]

  @@index([familyId])
}

model SecretSantaAssignment {
  santaId    String
  giverId    String
  receiverId String
  santa      SecretSanta @relation(fields: [santaId], references: [id], onDelete: Cascade)
  giver      User        @relation("SantaGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiver   User        @relation("SantaReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@id([santaId, giverId])
}
