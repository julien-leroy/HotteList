# Chemin relatif au dossier prisma/ : la base est donc dans ./data/hottelist.db
DATABASE_URL="file:../data/hottelist.db"
# Chaîne aléatoire longue : openssl rand -hex 32
AUTH_SECRET="à-remplacer"
APP_URL="https://hottelist.julienfluenceur.online"
PORT=9000

# ---- E-mails (facultatif : sans ces lignes, tout ce qui concerne l'e-mail est masqué) ----
# Amen : utiliser le nom du serveur qui correspond à son certificat TLS (smtp-fr.securemail.pro),
# plutôt que l'alias smtp.julienfluenceur.online.
SMTP_HOST="smtp-fr.securemail.pro"
SMTP_PORT=465
SMTP_USER="noreply@julienfluenceur.online"
SMTP_PASS="mot-de-passe-de-la-boîte"
MAIL_FROM="HotteList <noreply@julienfluenceur.online>"
